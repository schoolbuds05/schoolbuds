{
  "expo": {
    "name": "SchoolBuds",
    "slug": "schoolbuds",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/schoolbuds-icon.png",
    "scheme": "schoolbuds",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.schoolbuds.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/schoolbuds-icon.png",
        "backgroundImage": "./assets/images/schoolbuds-icon.png",
        "monochromeImage": "./assets/images/schoolbuds-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/schoolbuds-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/schoolbuds-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "db573324-fdb6-4197-8476-315ac1bebafd"
      }
    },
    "owner": "schoolbuds05s-team"
  }
}
